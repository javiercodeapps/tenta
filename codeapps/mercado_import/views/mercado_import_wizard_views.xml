<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mercado_import_wizard_form" model="ir.ui.view">
        <field name="name">mercado.import.wizard.form</field>
        <field name="model">mercado.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Nueva Importacion">
                <sheet>
                    <group>
                        <group>
                            <field name="data_file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="parent_company_ref"/>
                            <field name="cajon_product_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_create_batch" string="Crear Batch"
                                type="object" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
