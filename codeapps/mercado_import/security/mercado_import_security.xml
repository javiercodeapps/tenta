<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_mercado_import" model="ir.module.category">
            <field name="name">Mercado Import</field>
            <field name="description">Mercado Import operations</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_mercado_import_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_mercado_import"/>
        </record>

        <record id="group_mercado_import_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_mercado_import"/>
            <field name="implied_ids" eval="[(4, ref('group_mercado_import_user'))]"/>
        </record>
    </data>
</odoo>
