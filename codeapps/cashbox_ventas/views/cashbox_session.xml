<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashbox_ventas" model="ir.ui.view">
        <field name="name">account_cashbox.ventas</field>
        <field name="model">account.cashbox.session</field>
        <field name="inherit_id" ref="account_cashbox.view_account_cashbox_session_form" />
        <field name="arch" type="xml">
            <field name="line_ids" position="after">
                <field name="resumen_ids" invisible="True" />
                <group>
                    <div class="alert alert-info" role="alert">
                        VENTAS
                    </div>
                    <field name="ventas_ids" nolabel="1" colspan="2">
                        <list create="false" delete="false">
                            <field name="type_pay_id" />
                            <field name="type_id" />
                            <field name="amount" sum="Total" />
                            <field name="count" sum="Cantidad" />
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert">
                        CUENTA CORRIENTE
                    </div>
                    <field name="ctacte_ids" nolabel="1" colspan="2">
                        <list create="false" delete="false">
                            <field name="type_pay_id" />
                            <field name="type_id" />
                            <field name="amount" sum="Total" />
                            <field name="count" sum="Cantidad" />
                        </list>
                    </field>
                </group>
                <group>
                    <div class="alert alert-info" role="alert">
                        GASTOS
                    </div>
                    <field name="gastos_ids" nolabel="1" colspan="2">
                        <list create="false" delete="false">
                            <field name="type_pay_id" />
                            <field name="type_id" />
                            <field name="amount" sum="Total" />
                            <field name="count" sum="Cantidad" />
                        </list>
                    </field>
                    <div class="alert alert-info" role="alert">
                        TRANSFERENCIAS
                    </div>
                    <field name="transf_ids" nolabel="1" colspan="2">
                        <list create="false" delete="false">
                            <field name="type_pay_id" />
                            <field name="type_id" />
                            <field name="amount" sum="Total" />
                            <field name="count" sum="Cantidad" />
                        </list>
                    </field>
                </group>
            </field>
            <button name="action_account_cashbox_session_close" position="after">
                <button name="action_account_cashbox_session_close_auth" string="Validar Con Diferencia" type="object" invisible="state != 'closing_control'" class="oe_highlight" />
            </button>
        </field>
    </record>

    
</odoo>