<odoo>
    <record id="view_partner_property_form" model="ir.ui.view">
        <field name="name">res.partner.form.account.modifications</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <!-- Eliminar el dominio del campo de Cuenta por Cobrar -->
            <field name="property_account_receivable_id" position="attributes">
                <attribute name="domain">[('deprecated', '=', False)]</attribute>
            </field>
            <!-- Eliminar el dominio del campo de Cuenta por Pagar -->
            <field name="property_account_payable_id" position="attributes">
                <attribute name="domain">[('deprecated', '=', False)]</attribute>
            </field>
        </field>
    </record>
</odoo>