<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_scan_qr_wizard" model="ir.ui.view">
        <field name="name">scan.qr.wizard.form</field>
        <field name="model">scan.qr.wizard</field>
        <field name="arch" type="xml">
            <form string="Escanee CODIGO QR">
                <group>
                    <field name="sale_order_id" string="Pedido" invisible="sale_order_id == False"/>
                    <field name="qr_code"/>
		            <field name="clave" string="Clave" invisible="sale_order_id == False"/>
                </group>
                <footer>
		                    
                    <button
                        name="action_process_qr"
                        string="Crear Orden"
                        type="object"
                        class="btn btn-primary "
                        invisible="sale_order_id != False"
                        />
                    <button
                        name="process_qr_add_lines"
                        string="Agregar Productos"
                        type="object"
                        class="btn btn-primary "
                        invisible="sale_order_id == False"
                    />
                    <button
                        name="process_qr_add_lines"
                        string="Agregar Productos Gratis "
                        type="object"
                        class="btn btn-warning "
                        invisible="sale_order_id == False"
                        context="{'free': True}"
                        />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_scan_qr_wizard" model="ir.actions.act_window">
        <field name="name">Scan QR Code</field>
        <field name="res_model">scan.qr.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_qr_sale_order_so"
          name="Nuevo Pedido QR"
          sequence="2"
    	  parent="fresherp_ventas.menu_fresherp_ventas_root"
          action="action_scan_qr_wizard"/>

</odoo>
