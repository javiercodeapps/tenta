<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_fresherp_ventas" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">sale.order</field>
    </record>

    <record id="action_fresherp_ventas_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="list_fresherp_ventas" />
        <field name="act_window_id" ref="action_fresherp_ventas" />
    </record>

    <record id="action_fresherp_ventas_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fresherp_ventas" />
        <field name="act_window_id" ref="action_fresherp_ventas" />
    </record>

    <record id="menu_fresherp_ventas_root" model="ir.ui.menu">
        <field name="name">FreshERP Ventas</field>
        <field name="web_icon">fresherp_ventas,static/description/icon.png</field>
        <field name="action" ref="action_fresherp_ventas" />
        <field name="sequence">0</field>
    </record>

    <menuitem id="menu_fresherp_ventas_partners" name="Clientes" parent="menu_fresherp_ventas_root" action="account.res_partner_action_customer" sequence="10" />
    <menuitem id="menu_fresherp_ventas_productos" name="Productos" parent="menu_fresherp_ventas_root" action="product.product_template_action" sequence="20" />
</odoo>
